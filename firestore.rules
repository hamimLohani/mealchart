rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function signedInEmail() {
      return isSignedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : "";
    }

    function isGroupAdmin(groupId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.groupId == groupId;
    }

    function hasOnlyFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isDateString(value) {
      return value is string
        && value.matches("^\\d{4}-\\d{2}-\\d{2}$");
    }

    // Admin create: verifying the admin owns the group in the batch write
    function isValidAdminCreate(adminId) {
      return isSignedIn()
        && request.auth.uid == adminId
        && hasOnlyFields(["id", "email", "fullName", "groupId", "createdAt"])
        && request.resource.data.id == adminId
        && request.resource.data.email is string
        && request.resource.data.email == signedInEmail()
        && request.resource.data.groupId is string
        && existsAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.adminId == request.auth.uid;
    }

    function isValidAdminUpdate(adminId) {
      return isSignedIn()
        && request.auth.uid == adminId
        && hasOnlyFields(["id", "email", "fullName", "groupId", "createdAt"])
        && request.resource.data.id == resource.data.id
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.email is string
        && request.resource.data.email == signedInEmail();
    }

    function isMonthKeyLocked(groupId, monthKey) {
      return exists(/databases/$(database)/documents/groups/$(groupId)/lockedMonths/$(monthKey))
        && get(/databases/$(database)/documents/groups/$(groupId)/lockedMonths/$(monthKey)).data.locked == true;
    }

    function isValidMealWrite(groupId, mealId) {
      return hasOnlyFields(["memberId", "date", "quantity", "monthKey"])
        && request.resource.data.memberId is string
        && request.resource.data.monthKey is string
        && request.resource.data.monthKey.matches("^\\d{4}-\\d{2}$")
        && isDateString(request.resource.data.date)
        && request.resource.data.date.matches("^" + request.resource.data.monthKey + "-\\d{2}$")
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 0
        && request.resource.data.quantity <= 20
        && int(request.resource.data.quantity * 4) == request.resource.data.quantity * 4
        && mealId == request.resource.data.memberId + "_" + request.resource.data.date
        && !isMonthKeyLocked(groupId, request.resource.data.monthKey)
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.resource.data.memberId))
        && (isGroupAdmin(groupId) || signedInEmail() == request.resource.data.memberId);
    }

    function canDeleteMeal(groupId) {
      return resource.data.keys().hasAll(["memberId", "date", "quantity", "monthKey"])
        && resource.data.monthKey is string
        && !isMonthKeyLocked(groupId, resource.data.monthKey);
    }

    /** Admin-only: add monthKey to legacy meal docs (allowed even when month is locked). */
    function isAdminMealMonthKeyBackfill(groupId) {
      return isGroupAdmin(groupId)
        && resource.data.keys().hasOnly(["memberId", "date", "quantity"])
        && request.resource.data.keys().hasOnly(["memberId", "date", "quantity", "monthKey"])
        && request.resource.data.memberId == resource.data.memberId
        && request.resource.data.date == resource.data.date
        && request.resource.data.quantity == resource.data.quantity
        && request.resource.data.monthKey is string
        && request.resource.data.monthKey.matches("^\\d{4}-\\d{2}$")
        && request.resource.data.date.matches("^" + request.resource.data.monthKey + "-\\d{2}$");
    }

    function isGroupOwner(groupId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && get(/databases/$(database)/documents/groups/$(groupId)).data.adminId == request.auth.uid;
    }

    function isAdminAccountMigration(groupId) {
      return isSignedIn()
        && resource.data.adminId != request.auth.uid
        && request.resource.data.adminId == request.auth.uid
        && request.resource.data.name == resource.data.name
        && request.resource.data.token == resource.data.token
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.active == resource.data.active
        && request.resource.data.currentChartId == resource.data.currentChartId
        && request.resource.data.currentChartMonth == resource.data.currentChartMonth
        && exists(/databases/$(database)/documents/admins/$(resource.data.adminId))
        && get(/databases/$(database)/documents/admins/$(resource.data.adminId)).data.groupId == groupId
        && get(/databases/$(database)/documents/admins/$(resource.data.adminId)).data.email == signedInEmail()
        && existsAfter(/databases/$(database)/documents/admins/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/admins/$(request.auth.uid)).data.groupId == groupId
        && getAfter(/databases/$(database)/documents/admins/$(request.auth.uid)).data.email == signedInEmail();
    }

    function isChartUnlocked(groupId, chartId) {
      return exists(/databases/$(database)/documents/groups/$(groupId)/charts/$(chartId))
        && get(/databases/$(database)/documents/groups/$(groupId)/charts/$(chartId)).data.locked != true;
    }

    function chartYearMonthPair(c) {
      return (c.year is int || c.year is float)
        && (c.month is int || c.month is float)
        && c.month >= 1
        && c.month <= 12;
    }

    /** YYYY-MM for the chart (stored monthKey or derived from year + month). */
    function chartEffectiveMonthKey(groupId, chartId) {
      let c = get(/databases/$(database)/documents/groups/$(groupId)/charts/$(chartId)).data;
      return c.monthKey is string && c.monthKey.matches("^\\d{4}-\\d{2}$")
        ? c.monthKey
        : (chartYearMonthPair(c)
            ? string(int(c.year)) + "-" + (int(c.month) < 10 ? "0" : "") + string(int(c.month))
            : "");
    }

    /** Cost/deposit date must fall in this chart's month (YYYY-MM) so edits never apply to another month. */
    function requestDateMatchesChartMonth(groupId, chartId) {
      let mk = chartEffectiveMonthKey(groupId, chartId);
      return exists(/databases/$(database)/documents/groups/$(groupId)/charts/$(chartId))
        && mk != ""
        && isDateString(request.resource.data.date)
        && request.resource.data.date.matches("^" + mk + "-\\d{2}$");
    }

    function isValidChartCostWrite(groupId, chartId) {
      return isGroupAdmin(groupId)
        && isChartUnlocked(groupId, chartId)
        && requestDateMatchesChartMonth(groupId, chartId)
        && hasOnlyFields(["id", "itemName", "amount", "date"])
        && request.resource.data.id is string
        && request.resource.data.itemName is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
    }

    function isValidChartDepositWrite(groupId, chartId) {
      return isGroupAdmin(groupId)
        && isChartUnlocked(groupId, chartId)
        && requestDateMatchesChartMonth(groupId, chartId)
        && hasOnlyFields(["id", "memberId", "amount", "date", "collectedByAdminId"])
        && request.resource.data.id is string
        && request.resource.data.memberId is string
        && request.resource.data.amount is number
        && request.resource.data.amount != 0
        && request.resource.data.collectedByAdminId is string
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.resource.data.memberId));
    }

    match /groups/{groupId} {
      allow read: if true;
      allow create: if isSignedIn()
        && hasOnlyFields(["id", "name", "token", "adminId", "currentChartId", "currentChartMonth", "createdAt", "active"])
        && request.resource.data.id == groupId
        && request.resource.data.name is string
        && request.resource.data.token is string
        && request.resource.data.adminId == request.auth.uid
        && request.resource.data.active == true;
      allow update: if isGroupAdmin(groupId) || isAdminAccountMigration(groupId);
      allow delete: if isGroupAdmin(groupId);
    }

    match /admins/{adminId} {
      allow read: if true;
      allow create: if isValidAdminCreate(adminId);
      allow update: if isValidAdminUpdate(adminId);
      allow delete: if false;
    }

    match /groups/{groupId}/members/{memberId} {
      allow read: if true;
      allow create, update, delete: if isGroupAdmin(groupId);
    }

    match /{path=**}/members/{memberId} {
      allow read: if true;
    }

    match /groups/{groupId}/joinRequests/{requestId} {
      allow read, update, delete: if isGroupAdmin(groupId);
      allow create: if isSignedIn()
        && hasOnlyFields(["id", "fullName", "email", "createdAt"])
        && request.resource.data.id == requestId
        && request.resource.data.email == signedInEmail();
    }

    match /groups/{groupId}/lockedMonths/{monthKey} {
      allow read: if true;
      allow create, update, delete: if isGroupAdmin(groupId);
    }

    match /groups/{groupId}/charts/{chartId} {
      allow read: if true;
      allow create, update, delete: if isGroupAdmin(groupId);

      match /deposits/{depositId} {
        allow read: if true;
        allow create: if isValidChartDepositWrite(groupId, chartId);
        allow update: if isValidChartDepositWrite(groupId, chartId);
        allow delete: if isGroupAdmin(groupId) && isChartUnlocked(groupId, chartId);
      }

      match /costs/{costId} {
        allow read: if true;
        allow create: if isValidChartCostWrite(groupId, chartId);
        allow update: if isValidChartCostWrite(groupId, chartId);
        allow delete: if isGroupAdmin(groupId) && isChartUnlocked(groupId, chartId);
      }

      match /notices/{noticeId} {
        allow read: if true;
        allow create: if (isGroupAdmin(groupId) || isGroupOwner(groupId)) && isChartUnlocked(groupId, chartId);
        allow update, delete: if isGroupAdmin(groupId) && isChartUnlocked(groupId, chartId);
      }
    }
    match /groups/{groupId}/meals/{mealId} {
      allow read: if true;
      allow create: if isValidMealWrite(groupId, mealId);
      allow update: if isValidMealWrite(groupId, mealId) || isAdminMealMonthKeyBackfill(groupId);
      allow delete: if isGroupAdmin(groupId) && canDeleteMeal(groupId);
    }

    // Legacy flat costs/deposits removed — all money data must live under charts/{chartId}/…
  }
}
